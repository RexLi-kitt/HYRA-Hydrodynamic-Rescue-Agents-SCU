          "text": "\t\t\t\tif (h_grid[index] > depth_thresh)"
        },
        {
          "line": 3207,
          "text": "\t\t\t\t{"
        },
        {
          "line": 3208,
          "text": "\t\t\t\t\tif (initHtm_grid[index] == NULLVAL)"
        },
        {
          "line": 3209,
          "text": "\t\t\t\t\t\tinitHtm_grid[index] = current_time_hours;"
        },
