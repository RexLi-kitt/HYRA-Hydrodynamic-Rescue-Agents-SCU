          "text": "\t\t\t\t\t// Update maximum water depths, and time of maximum (in hours)"
        },
        {
          "line": 3213,
          "text": "\t\t\t\t\tmaxHtm_grid[index] = (h_grid[index] > maxH_grid[index]) ? current_time_hours : maxHtm_grid[index];"
        },
        {
          "line": 3214,
          "text": "\t\t\t\t\tmaxH_grid[index] = (h_grid[index] > maxH_grid[index]) ? h_grid[index] : maxH_grid[index];"
