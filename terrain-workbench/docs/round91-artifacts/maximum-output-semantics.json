        },
        {
          "line": 4651,
          "text": "\t\t\t\t\t// update h to be 'depth' above sub-grid-channel"
        },
        {
          "line": 4652,
          "text": "\t\t\t\t\tfor (int j = 0; j < grid_rows; j++)"
        },
        {
          "line": 4653,
          "text": "\t\t\t\t\t{"
        },
        {
          "line": 4654,
          "text": "\t\t\t\t\t\tfor (int i = 0; i < grid_cols; i++)"
        },
        {
          "line": 4655,
