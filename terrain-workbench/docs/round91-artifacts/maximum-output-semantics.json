          "line": 4638,
          "text": "\t\t\t\t\t\t\tNUMERIC_TYPE temp = maxH_grid[index_padded] + SGC_BankFullHeight_grid[index_padded];"
        },
        {
          "line": 4639,
          "text": "\t\t\t\t\t\t\t// depth in channel or above flood plain = h + BankFullHeight (should not be negative)"
        },
        {
          "line": 4640,
          "text": "\t\t\t\t\t\t\t// note previous version just dumped the wd with no depth_thresh truncation"
        },
        {
          "line": 4641,
          "text": "\t\t\t\t\t\t\tif (temp <= depth_thresh)"
        },
        {
          "line": 4642,
          "text": "\t\t\t\t\t\t\t\ttemp = C(0.0);"
        },
        {
          "line": 4643,
          "text": "\t\t\t\t\t\t\ttmp_grid1[index] = temp;"
        },
        {
          "line": 4644,
          "text": "\t\t\t\t\t\t}"
