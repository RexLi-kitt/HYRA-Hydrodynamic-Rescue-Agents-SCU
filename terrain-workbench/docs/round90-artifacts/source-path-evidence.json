      {
        "line": 731,
        "text": "\t{"
      },
      {
        "line": 732,
        "text": "\t\t// enables the sgm_fast optimized version, without necessarily having any channels"
      },
      {
        "line": 733,
        "text": "\t\tStatesptr->SGC = ON;"
      },
      {
        "line": 734,
        "text": "\t\tStatesptr->acceleration = ON; // sug-grid channels only work with acceleration model so ensure its in this model."
      },
      {
        "line": 735,
        "text": "\t\tStatesptr->adaptive_ts = OFF;"
      },
      {
        "line": 736,
        "text": "\t\tStatesptr->qlim = OFF;"
      },
      {
        "line": 737,
        "text": "\t\tif (verbose == ON) printf(\"Using sub-grid channels and acceleration formulation\\n\");"
      }
    ]
